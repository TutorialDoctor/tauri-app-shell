{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app-shell",
  "version": "0.1.0",
  "identifier": "com.tutorialdoctor.tauri-app-shell",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-app-shell",
        "width": 1900,
        "height": 1400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**","$RESOURCE/gallery-media/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*",
      "resources/data.json",
      "resources/bible-sqlite.db",
      "resources/scripts/*",
      "resources/voices/*",
      "gallery-media/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}